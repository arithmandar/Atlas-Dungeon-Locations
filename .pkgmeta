package-as: Atlas_DungeonLocs

manual-changelog:
    filename: Docs/ChangeLog.md
    markup-type: markdown
    
enable-nolib-creation: no

# configs for WowInterface
wowi-archive-previous: yes
wowi-create-changelog: no

ignore:
    - Images/PSD
    - Images/DLBrokenIsles/PSD
    - Images/DLEast/PSD
    - Images/DLWest/PSD
    - Images/DLOutland/PSD
    - Images/DLNorthrend/PSD
    - Images/DLDraenor/PSD
    - Images/DLPandaria/PSD
    - Images/DLArgus/PSD
